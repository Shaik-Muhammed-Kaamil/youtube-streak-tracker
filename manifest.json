{
  "manifest_version": 3,
  "name": "YouTube Streak Tracker",
  "version": "1.0.0",
  "description": "Tracks active YouTube watching time for personal streaks.",
  "permissions": [
    "storage",
    "tabs",
    "idle"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/watch*"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}